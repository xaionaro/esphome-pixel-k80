  check_case(pairs-${case_id} "${content}" TRUE "")
endforeach()
foreach(pairs IN ITEMS "1a" "01A" "49A" "1G" "1A,1A" "1A," "1A, 2B" "1A,1B,1C,1D,1E,1F,2A")
  string(MD5 case_id "${pairs}")
  string(REPLACE "  id: pixel_controller\n" "  id: pixel_controller\n  position_capacity: 6\n  initial_pairs: '${pairs}'\n" content "${base}")
  check_case(bad-pairs-${case_id} "${content}" FALSE "channel|unique|exceeds")
endforeach()
