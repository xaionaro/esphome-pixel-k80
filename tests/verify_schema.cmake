if(NOT EXISTS "${ESPHOME_EXECUTABLE}")
  message(FATAL_ERROR "Schema checks require ESPHOME_EXECUTABLE")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(READ "${PROJECT_DIR}/tests/fixtures/schema-base.yaml" base)
string(REPLACE "@COMPONENTS@" "${PROJECT_DIR}/components" base "${base}")
string(REPLACE "build_path: build" "build_path: ${OUTPUT_DIR}/build" base "${base}")

function(check_case name content expected diagnostic)
  set(path "${OUTPUT_DIR}/${name}.yaml")
  file(WRITE "${path}" "${content}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env PYTHONDONTWRITEBYTECODE=1
      "${ESPHOME_EXECUTABLE}" config "${path}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
  file(WRITE "${OUTPUT_DIR}/${name}.log" "${output}${error}")
  if(expected)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${name}: expected valid configuration: ${output}${error}")
    endif()
  else()
    if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${diagnostic}")
      message(FATAL_ERROR "${name}: wrong rejection (${result}), expected '${diagnostic}': ${output}${error}")
    endif()
  endif()
endfunction()

check_case(default "${base}" TRUE "")
function(check_typed_positions path expected)
  file(READ "${path}" code)
  string(REGEX MATCHALL "new\\([^)]*\\) yiscaxia::YiscaxiaLightState\\(" typed "${code}")
  list(LENGTH typed count)
  if(NOT count EQUAL expected OR code MATCHES "new\\([^)]*\\) light::LightState\\(")
    message(FATAL_ERROR "Expected ${expected} typed position states in ${path}, got ${count}")
  endif()
endfunction()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env PYTHONDONTWRITEBYTECODE=1
    "${ESPHOME_EXECUTABLE}" compile "${OUTPUT_DIR}/default.yaml" --only-generate
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "default codegen failed: ${output}${error}")
endif()
check_typed_positions("${OUTPUT_DIR}/build/src/main.cpp" 12)
foreach(capacity IN ITEMS 6 12 64)
  string(REPLACE "  id: pixel_controller\n" "  id: pixel_controller\n  position_capacity: ${capacity}\n" content "${base}")
  check_case(capacity-${capacity} "${content}" TRUE "")
  file(READ "${OUTPUT_DIR}/capacity-${capacity}.log" validated)
  string(REGEX MATCHALL "id: pixel_controller_position_[0-9]+\n" ids "${validated}")
  list(LENGTH ids count)
  if(NOT count EQUAL capacity)
    message(FATAL_ERROR "capacity-${capacity}: expected ${capacity} stable lights, got ${count}")
  endif()
endforeach()
foreach(capacity IN ITEMS 5 65)
  string(REPLACE "  id: pixel_controller\n" "  id: pixel_controller\n  position_capacity: ${capacity}\n" content "${base}")
  check_case(capacity-${capacity} "${content}" FALSE "position_capacity")
endforeach()
foreach(pairs IN ITEMS "1A,2B,2D" "1A,-,2D" "" "1A,-,-")
